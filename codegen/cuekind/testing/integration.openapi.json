{
  "openapi": "3.0.3",
  "info": {
    "title": "Integration test external routes",
    "version": "v1",
    "x-grafana-api-group": "integration.ext.grafana.app"
  },
  "paths": {
    "/reports": {
      "get": {
        "operationId": "getClusterReport",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Report"
          }
        }
      }
    },
    "/namespaces/{namespace}/reports": {
      "get": {
        "operationId": "getNamespacedReport",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Report"
          }
        }
      }
    },
    "/namespaces/{namespace}/foos/{name}/report": {
      "get": {
        "operationId": "getFooReport",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Report"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Report": {
        "type": "object",
        "description": "A response type supplied by OpenAPI rather than CUE.",
        "required": ["message", "count"],
        "properties": {
          "message": { "type": "string" },
          "count": { "type": "integer", "format": "int64", "minimum": 0 }
        }
      }
    },
    "responses": {
      "Report": {
        "description": "The generated report",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Report" }
          }
        }
      }
    }
  }
}
